{%- from "_macros.svg.j2" import card_container -%}
<svg xmlns="http://www.w3.org/2000/svg"
     width="{{ w }}" height="{{ h }}">
{%- if has_entity -%}
{#- Temperature gradient for the curve, sampled from its own
    values -- mirrors graph.svg.j2's threshold-gradient <defs>. -#}
{%- if (curve_path or curve_points) and curve_stops -%}
<defs>
<linearGradient id="mgTempGradient"
  gradientUnits="userSpaceOnUse"
  x1="{{ plot_left }}" y1="0"
  x2="{{ content_right }}" y2="0">
{%- for stop in curve_stops -%}
<stop offset="{{ stop.offset }}" stop-color="{{ stop.color }}"/>
{%- endfor -%}
</linearGradient>
</defs>
{%- endif -%}
{%- call card_container(
    x=0, y=0, w=w, h=h,
    card_style=card_style,
    radius=m_radius, border=m_border,
    bar_width=bar_width,
    border_color=hex_black,
    bar_color=hex_gray) -%}
{#- Day-boundary markers: dashed line (all but the first) plus a
    weekday/date label. -#}
{%- for marker in day_markers -%}
{%- if marker.show_line -%}
<line x1="{{ marker.x }}" y1="{{ marker.line_y1 }}"
      x2="{{ marker.x }}" y2="{{ marker.line_y2 }}"
      stroke="{{ hex_gray }}" stroke-width="1"
      stroke-dasharray="4,3"/>
{%- endif -%}
<text x="{{ marker.x }}" y="{{ day_label_y }}"
  font-family="Roboto"
  font-size="{{ day_label_font_sz }}"
  font-weight="{{ day_label_font_weight }}"
  dominant-baseline="hanging"
  fill="{{ hex_black }}">{{ marker.label }}</text>
{%- endfor -%}
{#- Cloud-coverage band: shaded area from the plot's top edge. -#}
{%- if show_cloud_band -%}
<path d="{{ cloud_band_path }}"
  fill="{{ hex_light_gray }}" fill-opacity="0.6" stroke="none"/>
{%- endif -%}
{#- Temperature fill: area under the curve down to the plot
    baseline, drawn before the gridlines so they stay readable. -#}
{%- if fill_path -%}
<path d="{{ fill_path }}" fill="{{ hex_light_gray }}" stroke="none"/>
{%- elif fill_points -%}
<polygon points="{{ fill_points }}"
  fill="{{ hex_light_gray }}" stroke="none"/>
{%- endif -%}
{#- Y-axis gridlines and labels.  The line spans the plot, which
    starts at plot_left to clear the labels anchored at content_left. -#}
{%- for grid in grid_lines -%}
<line x1="{{ plot_left }}" y1="{{ grid.y }}"
      x2="{{ content_right }}" y2="{{ grid.y }}"
      stroke="{{ hex_light_gray }}"
      stroke-width="{{ grid_stroke_w }}"/>
<text x="{{ content_left }}" y="{{ grid.label_y }}"
  font-family="Roboto"
  font-size="{{ grid_font_sz }}"
  font-weight="{{ grid_font_weight }}"
  dominant-baseline="auto"
  fill="{{ hex_gray }}">{{ grid.label }}</text>
{%- endfor -%}
{#- Precipitation bars: grow upward from the plot baseline, with
    an optional amount label above (omitted where it would collide
    with a neighbouring label). Drawn after the gridlines so bars
    and their labels aren't cut through by a crossing gridline. -#}
{%- if show_precip -%}
{%- for bar in precip_bars -%}
<rect x="{{ bar.x }}" y="{{ bar.y }}"
  width="{{ bar.w }}" height="{{ bar.h }}"
  fill="{{ hex_gray }}" fill-opacity="0.5"/>
{%- if bar.label -%}
<text x="{{ bar.label_x }}" y="{{ bar.label_y }}"
  font-family="Roboto"
  font-size="{{ precip_font_sz }}"
  font-weight="{{ precip_font_weight }}"
  text-anchor="middle"
  dominant-baseline="auto"
  fill="{{ hex_black }}">{{ bar.label }}</text>
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{#- Temperature curve, colored along its length by value, or a
    solid black line when no gradient applies (2-level displays).
    Smoothing off switches the path to a straight-segment polyline,
    mirroring graph.svg.j2's line/polyline split. -#}
{%- if curve_path -%}
<path d="{{ curve_path }}"
  fill="none"
  stroke="{{ 'url(#mgTempGradient)' if curve_stops else hex_black }}"
  stroke-width="{{ curve_stroke_w }}"
  stroke-linejoin="round"
  stroke-linecap="round"/>
{%- elif curve_points -%}
<polyline points="{{ curve_points }}"
  fill="none"
  stroke="{{ 'url(#mgTempGradient)' if curve_stops else hex_black }}"
  stroke-width="{{ curve_stroke_w }}"
  stroke-linejoin="round"
  stroke-linecap="round"/>
{%- endif -%}
{#- Condition icons, floating just above the curve. -#}
{%- for icon in icons -%}
<g transform="translate({{ icon.x }}, {{ icon.y }})">{{ icon.svg }}</g>
{%- endfor -%}
{#- Hour-axis ticks below the plot. -#}
{%- for tick in hour_ticks -%}
<text x="{{ tick.x }}" y="{{ hour_row_y }}"
  font-family="Roboto"
  font-size="{{ hour_font_sz }}"
  font-weight="{{ hour_font_weight }}"
  text-anchor="{{ tick.anchor }}"
  dominant-baseline="hanging"
  fill="{{ hex_gray }}">{{ tick.label }}</text>
{%- endfor -%}
{%- endcall -%}
{#- No entity or no usable hourly forecast: render blank SVG. -#}
{%- endif -%}
</svg>
